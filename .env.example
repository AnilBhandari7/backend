# MongoDB Atlas URI (required for cloud deployments - localhost won't work on Render)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/safety_detective?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
PORT=5000
# Your deployed frontend URL for CORS (no trailing slash)
FRONTEND_URL=https://your-frontend.onrender.com
